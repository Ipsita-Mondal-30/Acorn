# mock = deterministic built-in reader, no network, no cost (default). meta = Meta Model API.
AI_PROVIDER=mock
# Second lock on spending: with AI_PROVIDER=meta, no request is sent unless this is true. Keep false until credits are active.
AI_ENABLE_REAL_CALLS=false

# Meta Model API (https://dev.meta.ai/docs/quickstart.md). Server-side only: never prefix with NEXT_PUBLIC_.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Primary multimodal memory-understanding model (text, images, PDFs). Chat Completions.
META_PRIMARY_MODEL=muse-spark-1.3
# Separately configurable capabilities. Only the reasoning model is ever called, and only when META_REASONING_FOR_PLANS=true.
META_REASONING_MODEL=muse-wonder-1.0
META_REASONING_FOR_PLANS=false
# Not called by Acorn yet; each has its own endpoint/format in the docs (images/generations, asr/transcribe, responses).
META_IMAGE_MODEL=muse-image-1.0
META_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0
META_SEGMENTATION_MODEL=sam-3.1

# Hard cap on paid model calls per server process (cost guard; each retry attempt counts)
ACORN_MAX_MODEL_CALLS=50
# Documented reasoning levels: minimal | low | medium | high | xhigh ("none" is rejected by Muse Spark). Lower = faster and cheaper.
META_REASONING_EFFORT=low
# Per-request timeout in ms (the API answers HTTP 504 when a non-streaming request runs too long)
META_TIMEOUT_MS=60000
# json_schema.strict. The docs say output is schema-constrained either way, and Acorn re-validates every answer with Zod.
META_STRICT_SCHEMA=false

# Where the local JSON store + uploads live (gitignored)
ACORN_DATA_DIR=.data

# ── Cloud mode (Supabase Auth + Postgres + private Storage) ──
# Leave BOTH of the first two blank to stay in local demo mode (JSON file on this machine, no accounts).
# Set both to use the cloud. Setting only one is an error, on purpose.
# Project settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. BYPASSES Row-Level Security. The app never uses it while serving requests; keep it for operator
# scripts only, never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Operator-only, used to apply migrations from your machine (`npx supabase db push --db-url "$DIRECT_URL"`).
# The running app never reads these. Connect -> pooler strings in the Supabase dashboard. If the database password
# contains @ / ? # [ ] or :, percent-encode it (@ becomes %40) or reset it to letters and digits.
# DIRECT_URL = session pooler (port 5432, for migrations); DATABASE_URL = transaction pooler (port 6543, for serverless clients).
DATABASE_URL=
DIRECT_URL=
# auto (default): cloud if the two values above are set, else local. local = force the demo store. supabase = require cloud.
ACORN_STORAGE=auto

# ── Semantic search (optional; off by default) ──
# Meta's Model API documents no embedding model. Point this at any OpenAI-compatible POST {base}/embeddings service.
# Paid calls: also requires AI_ENABLE_REAL_CALLS=true. See README "Semantic (meaning-based) search".
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Hybrid ranking (uncalibrated defaults; re-tune with a real provider, see docs/pgvector.md)
SEARCH_SEMANTIC_WEIGHT=10
SEARCH_KEYWORD_WEIGHT=1
SEARCH_MIN_SIMILARITY=0.35
SEARCH_SEMANTIC_LIMIT=20

# ── Scheduled notifications (optional; see docs/notifications.md) ──
# The scheduler calls POST /api/cron/tick with "Authorization: Bearer <CRON_SECRET>". Unset = the endpoint does not exist.
# Generate one: openssl rand -hex 32   (at least 32 characters; server-side only, never NEXT_PUBLIC)
CRON_SECRET=
# Email is optional and off unless ALL of these are set. Real sending needs NOTIFICATIONS_ENABLE_SENDING=true.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=
APP_BASE_URL=
NOTIFICATIONS_ENABLE_SENDING=false
# A reminder this many hours overdue when Acorn first looks at it is shown as overdue instead of announced
NOTIFY_EXPIRY_HOURS=72
# Local (no accounts) mode only: where email goes
NOTIFY_LOCAL_EMAIL=
