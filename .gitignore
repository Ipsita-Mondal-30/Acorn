# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# acorn local data: memories, uploads, CVs — never commit
/.data/
*.pdf
*.docx
# test fixtures are fictional and small: keep them even though real CVs (*.pdf, *.docx) are ignored everywhere else
!tests/fixtures/*.pdf
!tests/fixtures/*.docx
# the fictional demo sample (generated by scripts/make-samples.mjs) that the built-in demo reads
!public/samples/*.pdf

# local assistant settings
/.claude/

# paid-check results (model output for fictional samples) and demo recordings; local only
/artifacts/
# isolated store used by `npm run demo` (memories, uploads, the generated local cron secret)
/.demo-data/
/.tmp/
*.log

# editor folders: a committed .vscode/tasks.json can run commands automatically when the folder is opened
/.idea/
config.bat
