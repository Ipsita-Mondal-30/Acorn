# Acorn configuration template.
#
#   cp .env.example .env.local
#
# NOTHING in this file is required to run the judge demo. `npm run demo` (and `npm run dev` with these defaults) starts
# with no account, no API key and no network calls. Every value below is a safe default or an empty placeholder.
# Never put real values in this file: real values go in .env.local, which git ignores. Never commit .env.local.
#
# Legend:  [default ok]  safe as shipped          [optional]  only for the integration named in the section
#          [paid]        enabling it can send billable requests (always behind AI_ENABLE_REAL_CALLS=true)
#          [secret]      server-only credential: never prefix with NEXT_PUBLIC_, never commit
#
# Note: `npm run demo` overrides the AI, storage, embedding and email settings below in its own process, so it stays
# offline and isolated whatever this file (or .env.local) says. See scripts/demo-env.mjs.

# ── Model provider and spending locks ─────────────────────────────────────────────────────────────────────────────────
# [default ok] mock = deterministic built-in reader, no network, no cost. meta = Meta Model API (live calls).
AI_PROVIDER=mock
# [default ok] Second lock: with AI_PROVIDER=meta, no request is sent unless this is exactly "true".
AI_ENABLE_REAL_CALLS=false
# [default ok] Hard cap on Meta model calls per server process (each retry counts). Resets on restart.
ACORN_MAX_MODEL_CALLS=50

# ── Meta Model API (live calls; optional) ─────────────────────────────────────────────────────────────────────────────
# [optional][secret][paid] Your own Meta Model API key from Meta's developer platform (https://dev.meta.ai/docs).
# Only read when AI_PROVIDER=meta AND AI_ENABLE_REAL_CALLS=true. Leave empty for the offline demo. Example format only:
#   META_API_KEY=<your-meta-model-api-key>
META_API_KEY=
# [default ok] OpenAI-compatible base URL of the Meta Model API.
META_BASE_URL=https://api.meta.ai/v1
# [default ok] Multimodal understanding (notes, links, screenshots, PDFs), intent, answers, plans, region reading.
META_PRIMARY_MODEL=muse-spark-1.3
# [default ok] Optional reasoning model for action plans. Only called when META_REASONING_FOR_PLANS=true.
META_REASONING_MODEL=muse-wonder-1.0
META_REASONING_FOR_PLANS=false
# [default ok] Speech-to-text for voice notes (POST /v1/asr/transcribe). Called only when you press Transcribe.
META_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0
# [default ok] Visual learning aid generation (POST /v1/images/generations). Called only when you press the button.
META_IMAGE_MODEL=muse-image-1.0
# [default ok] Image segmentation for "Explore image" (POST /v1/responses). Called only when you ask it to look for something.
META_SEGMENTATION_MODEL=sam-3.1
# [default ok] minimal | low | medium | high | xhigh ("none" is rejected by Muse Spark). Lower = faster and cheaper.
META_REASONING_EFFORT=low
# [default ok] Per-request timeout in milliseconds (1000 to 300000).
META_TIMEOUT_MS=60000
# [default ok] Sent as json_schema.strict. Acorn re-validates every answer with Zod either way.
META_STRICT_SCHEMA=false
# Older names still accepted (the names above win): ACORN_MODE (demo|meta), META_API_BASE_URL, META_EXTRACTION_MODEL,
# META_PLAN_MODEL (a different model for plans). ACORN_RETRY_BASE_MS (default 750) tunes retry backoff.

# ── Local storage (default: no accounts) ──────────────────────────────────────────────────────────────────────────────
# [default ok] Folder for the local JSON store and uploads (gitignored). Must not be empty. `npm run demo` uses .demo-data/.
ACORN_DATA_DIR=.data
# [default ok] auto = Supabase if both NEXT_PUBLIC_SUPABASE_* values are set, else local. local = always local. supabase = require cloud.
ACORN_STORAGE=auto

# ── Demo replay (set automatically by `npm run demo`; leave unset here) ───────────────────────────────────────────────
# ACORN_DEMO_REPLAY=1 replays ONE saved, previously recorded Muse Spark result for the built-in job-listing sample, labelled
# "Saved result, replayed" on screen. No request is made. The saved file (artifacts/meta-live/...) is NOT in the public
# repository, so in a fresh clone replay stays off and every reading is the labelled mock.
# ACORN_DEMO_REPLAY=
# ACORN_DEMO_REPLAY_FILE=artifacts/meta-live/<saved-result>.json

# ── Cloud mode: Supabase Auth + Postgres + private Storage (optional; not needed for the demo) ────────────────────────
# Leave BOTH blank to stay in local mode. Setting only one is a startup error, on purpose.
# [optional] Project URL and anon/publishable key (Supabase dashboard -> Project Settings -> API). Public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [optional][secret] BYPASSES Row-Level Security. Used only by the scheduled notification worker (/api/cron/tick) in cloud
# mode and by operator scripts; never while serving a user's request.
SUPABASE_SERVICE_ROLE_KEY=
# [optional][secret] Operator-only, for applying migrations from your machine. The running app never reads these.
# DIRECT_URL = session pooler (port 5432, migrations); DATABASE_URL = transaction pooler (port 6543). Example format only:
#   DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=
DIRECT_URL=

# ── Semantic search (optional; off by default) ────────────────────────────────────────────────────────────────────────
# Meta's Model API documents no embedding model. Any OpenAI-compatible POST {base}/embeddings service works; it also needs
# AI_ENABLE_REAL_CALLS=true. Vectors go to the local JSON store or, in cloud mode, pgvector. none = keyword search only.
EMBEDDING_PROVIDER=none
# [optional] e.g. https://<provider>/v1
EMBEDDING_BASE_URL=
# [optional][secret][paid]
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
# [default ok] Hybrid ranking knobs (uncalibrated; see docs/pgvector.md).
SEARCH_SEMANTIC_WEIGHT=10
SEARCH_KEYWORD_WEIGHT=1
SEARCH_MIN_SIMILARITY=0.35
SEARCH_SEMANTIC_LIMIT=20

# ── Reminders and notifications (optional; see docs/notifications.md) ─────────────────────────────────────────────────
# [optional][secret] Bearer secret for POST /api/cron/tick (the reminder worker). Unset = the endpoint does not exist.
# At least 32 characters; generate with: openssl rand -hex 32. `npm run demo` generates its own in .demo-data/.
CRON_SECRET=
# [default ok] Email is off unless EMAIL_PROVIDER, EMAIL_API_KEY, EMAIL_FROM are set AND NOTIFICATIONS_ENABLE_SENDING=true.
# none | resend. The in-app inbox works without any of these.
EMAIL_PROVIDER=none
# [optional][secret][paid] Resend API key.
EMAIL_API_KEY=
# [optional] Verified sender, e.g. Acorn <reminders@your-domain.example>
EMAIL_FROM=
# [optional] Public address of this app, used for links inside emails.
APP_BASE_URL=
NOTIFICATIONS_ENABLE_SENDING=false
# [default ok] A reminder this many hours overdue when Acorn first sees it is shown as overdue instead of announced.
NOTIFY_EXPIRY_HOURS=72
# [optional] Local (no accounts) mode only: the address email would go to.
NOTIFY_LOCAL_EMAIL=

# ── Manual paid checks (command line only; never put these in a file) ────────────────────────────────────────────────
# tests/live/* refuse to run unless confirmed per check, e.g.  META_LIVE_CONFIRM=voice META_KEY_ROTATED=yes npm run meta:live:voice
# META_LIVE_DRY_RUN=1 runs the same harness against a stubbed API with a fake key (no network, no cost).
